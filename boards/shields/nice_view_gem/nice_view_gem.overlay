&nice_view_spi {
    status = "okay";
    nice_view: ls0xx@0 {
        compatible = "sharp,ls0xx";
        spi-max-frequency = <1000000>;
        reg = <0>;
        width = <144>;
        height = <168>;
    };
};

/ {
    chosen {
        zephyr,display = &nice_view;
    };

    // Receives layer/host/battery status from the central (dongle) on a
    // peripheral. Node name must match STATUS_SYNC_BEHAVIOR_NAME.
    behaviors {
        status_sync: status_sync {
            compatible = "zmk,behavior-status-sync";
            #binding-cells = <0>;
        };
    };
};
